<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\MechGarage.Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 or newer: Windows' modern speech recogniser (Windows.Media.SpeechRecognition). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Lets the build run on Linux too (CI and checks); the app itself only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MechGarage.Windows</RootNamespace>
    <AssemblyName>MechGarage</AssemblyName>
    <Product>Mech Garage</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\..\store\icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WebView2's package also ships a WPF control we don't use; its WindowsBase version note is harmless. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
  </ItemGroup>

  <!-- The game itself: the web folder, copied next to MechGarage.exe. -->
  <ItemGroup>
    <None Include="..\..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
